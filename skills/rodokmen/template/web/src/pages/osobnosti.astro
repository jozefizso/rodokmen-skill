---
// Významné osobnosti rodokmenu: předci s výjimečným povoláním nebo postavením.
// Kategorie odpovídají tools/osobnosti.py. Ruční popis v osoby.py (pole vyz) má přednost a jde nahoru.
import Base from '../layouts/Base.astro';
import { people, href, statusClass } from '../lib/data.js';

const KATEGORIE = [
  ['Vzdělanci a duchovní', /(?<![\p{L}\p{N}_])(farář|kaplan|kněz|děkan|vikář|kanovník|biskup|páter|učitel|řídící|profesor|ředitel škol|doktor|dr\.|lékař|ranhojič|chirurg|advokát|notář|soudce|inženýr|ing\.|architekt|lékárník|studoval|absolvent|maturit|univerzit)/iu],
  ['Vědci a vynálezci', /(?<![\p{L}\p{N}_])(vědec|badatel|vynález|patent|astronom|chemik|fyzik|botanik|přírodověd|historik|archivář|akademi)/iu],
  ['Umělci', /(?<![\p{L}\p{N}_])(malíř|sochař|hudebník|muzikant|kapelník|varhaník|ředitel kůru|regenschori|skladatel|zpěvák|herec|herečka|spisovatel|básník|fotograf|kreslíř|řezbář)/iu],
  ['Funkcionáři a úředníci', /(?<![\p{L}\p{N}_])(starosta|purkmistr|rychtář|radní|obecní|poslanec|senátor|úředník|správce|vrchní|hejtman|purkrabí|důchodní|direktor|předseda|místopředseda|jednatel|okresní|zemský|četník|četnick|celník|poštmistr|přednosta)/iu],
  ['Vojáci a důstojníci', /(?<![\p{L}\p{N}_])(důstojník|poručík|nadporučík|setník|kapitán|major|plukovník|generál|šikovatel|legionář|legie|vyznamenán|medail)/iu],
  ['Sportovci', /(?<![\p{L}\p{N}_])(sportov|sokol|závodník|reprezent|olympi|mistr republiky|fotbal|hokej|lyžař|atlet|gymnast|cvičitel)/iu],
  ['Mistři, sedláci a podnikatelé', /(?<![\p{L}\p{N}_])(továrník|majitel továrny|podnikatel|statkář|velkostatk|sedlák|mlynář|sládek|pivovar|hostinsk|obchodník|kupec|stavitel|mistr|firma)/iu],
];

const all = Object.values(people);
const rucne = all.filter((p) => p.vyz);
const skupiny = KATEGORIE.map(([nazev, rx]) => ({
  nazev,
  lidi: all
    .filter((p) => !p.vyz)
    .map((p) => ({ p, fakt: p.facts.find((t) => rx.test(t)) }))
    .filter((x) => x.fakt)
    .sort((a, b) => a.p.k - b.p.k),
})).filter((g) => g.lidi.length);
const nikdo = !rucne.length && !skupiny.length;
---
<Base title="Významné osobnosti">
  <h1>Významné osobnosti rodokmenu</h1>
  <p class="lead">Ručně označené osoby a možné náměty k dalšímu výzkumu podle slov v jejich faktech. Automatická shoda sama nedokládá významnost ani správnost údaje.</p>

  {rucne.length > 0 && (
    <section>
      <h2>Ručně označené osoby</h2>
      <ul class="osobnosti">
        {rucne.map((p) => (
          <li><a class={statusClass(p.st)} href={href.person(p.slug)}>{p.name}</a> <span class="muted">{p.years} · {p.rel}</span><br />{p.vyz}</li>
        ))}
      </ul>
    </section>
  )}

  {skupiny.map((g) => (
    <section>
      <h2>Možné náměty: {g.nazev}</h2>
      <ul class="osobnosti">
        {g.lidi.map(({ p, fakt }) => (
          <li><a class={statusClass(p.st)} href={href.person(p.slug)}>{p.name}</a> <span class="muted">{p.years} · {p.rel}</span><br /><span class="small">{fakt}</span></li>
        ))}
      </ul>
    </section>
  ))}

  {nikdo && <p>Zatím tu nejsou ručně označené osoby ani automatické shody.</p>}

  <p class="small muted">Automatické shody jsou jen náměty podle slov ve faktech; mohou být nepřesné a je třeba je ověřit v pramenech.</p>
</Base>

<style>
  .osobnosti { list-style: none; padding: 0; }
  .osobnosti li { margin: 0 0 0.9em; }
</style>
